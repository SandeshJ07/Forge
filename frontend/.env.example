# Copy this file to .env and fill in your own values.
# Client-side vars must be prefixed with EXPO_PUBLIC_ to be readable in the app bundle.

# --- Forge backend (FastAPI) ---
# Local dev default; point at your deployed backend's URL in other environments.
EXPO_PUBLIC_API_URL=http://localhost:8000

# --- Google sign-in (optional) ---
# OAuth client IDs from Google Cloud Console → APIs & Services → Credentials.
# The "Continue with Google" button only shows on platforms with an ID set.
# The backend's GOOGLE_CLIENT_IDS must list the same IDs.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
