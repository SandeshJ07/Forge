# Copy this file to .env and fill in your own values.

# --- Your own Postgres instance ---
DATABASE_URL=postgresql+psycopg://forge:forge@localhost:5432/forge

# --- Auth ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string

# --- Encryption at rest ---
# Encrypts API keys, emails, body data, notes and progress photos. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# BACK THIS UP. Without it, encrypted data (and every user's email) is unreadable.
DATA_ENCRYPTION_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- AI plan generation ---
# Each user picks Anthropic (Claude) or Google Gemini in the app and can add
# their own key for it (PUT /ai-keys/{provider}), which is preferred. These
# shared keys are the optional fallback when a user hasn't added one.
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order if the main Gemini model is overloaded (503), rate-limited or retired.
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash-lite
# Plan generations per user per day (resets at the user's local midnight) on the
# shared keys above. Users who add their own key have no limit. 0 = shared keys off.
SHARED_KEY_DAILY_PLAN_LIMIT=5

# --- Google sign-in (optional) ---
# OAuth client IDs whose ID tokens POST /auth/google accepts — the same IDs as
# the frontend's EXPO_PUBLIC_GOOGLE_*_CLIENT_ID (web, iOS, Android), comma-
# separated. Empty = Google sign-in off.
GOOGLE_CLIENT_IDS=

# --- File storage (progress photos) ---
# Progress photos are off by default; set true to turn the endpoints back on
# (and FEATURES.progressPhotos in the frontend).
PROGRESS_PHOTOS_ENABLED=false
STORAGE_DIR=storage

# --- CORS ---
# Comma-separated list of origins the frontend is served from.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,https://forge-bro.vercel.app

# --- Email (verification codes + password reset codes) ---
# EMAIL_PROVIDER: smtp (uses SMTP_* below), brevo or resend (HTTPS APIs, need
# EMAIL_API_KEY). Use brevo/resend on hosts that block outbound SMTP — Render's
# free plan blocks ports 25/465/587. Brevo can send from a single verified
# address (e.g. your Gmail) without owning a domain; Resend needs a verified
# domain to email anyone but yourself. SMTP_FROM_ADDRESS is the sender for all.
EMAIL_PROVIDER=smtp
EMAIL_API_KEY=
EMAIL_FROM_NAME=Forge
# The web app's public URL — emails link to it and show its logo.
APP_URL=https://forge-bro.vercel.app

# --- SMTP ---
# Leave SMTP_HOST empty for local dev without a real mail server — codes are
# printed to the backend's console log instead of actually emailed.
# For Gmail: smtp.gmail.com, port 587, an App Password (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@forge.app
SMTP_USE_TLS=true
EMAIL_CODE_EXPIRE_MINUTES=30
