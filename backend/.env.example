# Copy this file to .env and fill in your own values.

# --- Your own Postgres instance ---
DATABASE_URL=postgresql+psycopg://forge:forge@localhost:5432/forge

# --- Auth ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- AI plan generation ---
# Each user picks Anthropic (Claude) or Google Gemini in the app and can add
# their own key for it (PUT /ai-keys/{provider}), which is preferred. These
# shared keys are the optional fallback when a user hasn't added one.
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order if the main Gemini model is overloaded (503), rate-limited or retired.
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash-lite
# Plan generations per user per day (resets at the user's local midnight) on the
# shared keys above. Users who add their own key have no limit. 0 = shared keys off.
SHARED_KEY_DAILY_PLAN_LIMIT=5

# --- File storage (progress photos) ---
STORAGE_DIR=storage

# --- CORS ---
# Comma-separated list of origins the frontend is served from.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# --- SMTP (email verification codes + password reset codes) ---
# Leave SMTP_HOST empty for local dev without a real mail server — codes are
# printed to the backend's console log instead of actually emailed.
# For Gmail: smtp.gmail.com, port 587, an App Password (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@forge.app
SMTP_USE_TLS=true
EMAIL_CODE_EXPIRE_MINUTES=30
